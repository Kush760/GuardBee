flowchart LR
  I[(incidents.json)] --> LI[load_incidents fail-closed]
  P[(policies.json)] --> LP[load_policies]
  LI --> E[analyze_incident]
  LP --> R[retrieve_policies]
  E --> Q[Investigation context]
  R --> Q
  Q --> A[generate_report optional]
  A --> C[validate_report_citations]
  C --> D[workflow can_record_decision / build_decision_record]
  D --> S[session_state.audit append]
  AS[audit_store.save_decision] -.->|not called by app.py| DB[(SQLite audit.db)]
