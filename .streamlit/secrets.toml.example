# Copy this file to .streamlit/secrets.toml locally. Never commit the copy.
NEBIUS_API_KEY = "paste-your-Nebius-Token-Factory-key-here"
# Set NEBIUS_MODEL to an exact ID from your Nebius Token Factory catalog.
# Model IDs are case-sensitive. Example default used by this repo:
NEBIUS_MODEL = "nvidia/nemotron-3-super-120b-a12b"
