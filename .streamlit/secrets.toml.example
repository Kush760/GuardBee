# Copy this file to .streamlit/secrets.toml locally. Never commit the copy.
NEBIUS_API_KEY = "paste-your-Nebius-Token-Factory-key-here"
# Confirm a model available to your Nebius account in the Token Factory catalog.
NEBIUS_MODEL = "nvidia/nemotron-3-super-120b-a12b"
# Optional: only for a key created on a regional endpoint.
# NEBIUS_BASE_URL = "https://api.tokenfactory.us-central1.nebius.com/v1/"
